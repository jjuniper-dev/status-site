{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HC PHAC PPTX Slide Spec",
  "type": "object",
  "required": ["deck"],
  "properties": {
    "deck": {
      "type": "object",
      "required": ["title", "audience", "type", "slides"],
      "properties": {
        "title": { "type": "string" },
        "audience": { "type": "string" },
        "type": { "type": "string" },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "slide_type"],
            "properties": {
              "title": { "type": "string" },
              "slide_type": { "type": "string" },
              "bullets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "layout": { "type": "string" },
              "visual_intent": { "type": "string" },
              "diagram_required": { "type": "boolean" },
              "diagram_kind": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}